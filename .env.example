# job-scout needs no secrets and no API keys.
# Every variable below is optional.

# Where local state lives (profile.json, seen.json, cache, run files). Default: ~/.job-scout
# JOB_SCOUT_HOME=

# Tests and evals only: replay recorded HTTP responses from this directory instead of the network.
# JOB_SCOUT_REPLAY_DIR=

# Maintainers only: record live HTTP responses into this directory (to refresh test fixtures).
# JOB_SCOUT_RECORD_DIR=
